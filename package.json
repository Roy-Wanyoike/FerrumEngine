{
  "name": "ferrumcss-landing",
  "version": "1.0.0",
  "private": true,
  "description": "FerrumEngine — a CSS effects engine and design system platform. Browse 540+ effects, design tokens, and live playground.",
  "license": "MIT",
  "author": "FerrumEngine Contributors",
  "homepage": "https://ferrumcss.space-z.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferrumcss/ferrumengine"
  },
  "bugs": {
    "url": "https://github.com/ferrumcss/ferrumengine/issues"
  },
  "keywords": [
    "css",
    "effects",
    "design-system",
    "design-tokens",
    "tailwind",
    "react",
    "nextjs",
    "animation",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "bash scripts/start-server.sh",
    "start:raw": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "bundle-report": "npx @next/bundle-analyzer",
    "budget": "node scripts/check-budget.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
