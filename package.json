{
  "name": "ferrum-engine",
  "version": "0.3.0",
  "private": true,
  "description": "FerrumEngine — Engineering Intelligence for AI-native Software. Analyze, verify, secure, optimize, and evolve applications.",
  "license": "MIT",
  "author": "FerrumEngine Contributors",
  "homepage": "https://github.com/Roy-Wanyoike/FerrumEngine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roy-Wanyoike/FerrumEngine"
  },
  "bugs": {
    "url": "https://github.com/Roy-Wanyoike/FerrumEngine/issues"
  },
  "keywords": [
    "frontend",
    "intelligence",
    "reliability",
    "analysis",
    "code-analysis",
    "architecture",
    "change-impact",
    "ai-agent",
    "safety-gate",
    "testing",
    "security",
    "graph",
    "dependency-analysis",
    "performance",
    "accessibility",
    "engineering-intelligence",
    "verification",
    "ir",
    "time-machine",
    "autonomous",
    "ai-native"
  ],
  "bin": {
    "ferrum": "./src/engine/cli/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node server.cjs",
    "start:raw": "next start",
    "start:loop": "while true; do node server.cjs; sleep 1; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build",
    "bundle-report": "npx @next/bundle-analyzer",
    "budget": "node scripts/check-budget.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "@roycss/effects": "*"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
