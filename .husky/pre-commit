#!/bin/sh
# FerrumEngine pre-commit hook
# Runs quality checks before allowing a commit
# Install: npx husky init (or copy .husky/ directory)

echo "🔒 Running pre-commit quality gates..."

echo "  → Type checking..."
npm run typecheck --silent
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Fix errors before committing."
  exit 1
fi

echo "  → Linting..."
npm run lint --silent
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Fix errors before committing."
  exit 1
fi

echo "  → Running tests..."
npm run test --silent
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Fix failures before committing."
  exit 1
fi

echo "✅ Pre-commit checks passed."
