{
  "name": "@ferrum/testing",
  "version": "0.0.1",
  "description": "Testing utilities for the Ferrum Design System",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@testing-library/react": ">=14.0.0",
    "jsdom": ">=22.0.0"
  },
