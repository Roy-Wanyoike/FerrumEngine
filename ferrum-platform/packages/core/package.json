{
  "name": "@ferrum/core",
  "version": "0.0.1",
  "description": "Core CSS output package for the Ferrum Platform",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./css": {
      "default": "./dist/index.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "dependencies": {
    "@ferrum/tokens": "file:../tokens"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "license": "MIT"
}