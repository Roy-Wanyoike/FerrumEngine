{
  "name": "@ferrum/tokens",
  "version": "0.0.1",
  "description": "Design tokens — the single source of truth for the Ferrum Platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css/*": "./dist/css/*.css",
    "./json/*": "./dist/json/*.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ferrum-tokens": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:ts && npm run build:css && npm run build:json && npm run build:scss",
    "build:css": "node dist/cli.js build:css",
    "build:json": "node dist/cli.js build:json",
    "build:ts": "tsup",
    "build:scss": "node dist/cli.js build:scss",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}