{
  "name": "@ferrum/a11y",
  "version": "0.0.1",
  "description": "Accessibility engine — WCAG contrast, focus visibility, ARIA validation, and motion safety for the Ferrum Platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "license": "MIT"
}