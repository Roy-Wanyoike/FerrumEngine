# ─────────────────────────────────────────────────────────────
# FerrumEngine / FerrumCSS — Environment Variables
# Copy this file to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
# Public version string displayed in the UI footer.
NEXT_PUBLIC_VERSION=1.0.0

# Canonical site URL (used for CORS, sitemap, SEO).
NEXT_PUBLIC_SITE_URL=https://ferrumcss.space-z.ai

# ── Cloud Features (optional) ────────────────────────────────
# Password for the cloud admin panel. Omit to disable.
# CLOUD_ADMIN_PASSWORD=

# Shared secret for API token authentication.
# CLOUD_API_TOKEN=

# ── Database ──────────────────────────────────────────────────
# SQLite database path (file: protocol). Omit for in-memory defaults.
# DATABASE_URL=file:./db/custom.db

# ── Supabase ──────────────────────────────────────────────────
# Supabase project URL (public, safe for client-side code).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (safe for client-side code).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server-side only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── Node ──────────────────────────────────────────────────────
# Set automatically by Next.js (development / production / test).
# NODE_ENV=development
